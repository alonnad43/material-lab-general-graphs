import numpy as np
import matplotlib.pyplot as plt
import os
from scipy.optimize import curve_fit
from scipy import stats

# === Data ===
angles_deg = np.array([0, 15, 30, 45, 60, 75, 90])
mass_g = np.array([0.00, -0.24, -0.52, -0.73, -0.91, -1.01, -1.05])
force_n = (mass_g / 1000) * 9.8  # convert g to kg, then F = m*g

# === Convert angles to radians for theoretical sin(θ) comparison ===
angles_rad = np.radians(angles_deg)
sin_theta = np.sin(angles_rad)

# === Define Fit Function ===
def sin_fit(theta, A):
    return A * np.sin(theta)

# === Fit the Curve ===
popt, pcov = curve_fit(sin_fit, angles_rad, force_n)
A = popt[0]  # Amplitude
A_uncertainty = np.sqrt(np.diag(pcov))[0]  # Uncertainty in A

# === Calculate Magnetic Field B ===
I = 5.0  # Current in Amperes (example value, replace with actual value)
L = 0.1  # Length of wire in meters (example value, replace with actual value)
B = A / (I * L)
B_uncertainty = A_uncertainty / (I * L)  # Error propagation for B

# === Statistical goodness-of-fit metrics ===
residuals = force_n - (np.max(force_n) * sin_theta)
ss_res = np.sum(residuals**2)  # Sum of squared errors
ss_tot = np.sum((force_n - np.mean(force_n))**2)  # Total sum of squares
r_squared = 1 - (ss_res / ss_tot)
rmse = np.sqrt(ss_res / len(force_n))

# Adjusted R-squared (optional for multiple regressors)
adjusted_r_squared = 1 - (1 - r_squared) * (len(force_n) - 1) / (len(force_n) - 1)  # Adjusted for single regressor

# === 95% Confidence Intervals for Slope and Intercept ===
alpha = 0.05  # 95% confidence level
t_crit = stats.t.ppf(1 - alpha / 2, df=len(force_n) - 2)
std_err_slope = np.sqrt(ss_res / (len(force_n) - 2)) / np.sqrt(np.sum((angles_rad - np.mean(angles_rad))**2))
std_err_intercept = std_err_slope * np.sqrt(np.sum(angles_rad**2) / len(force_n))
conf_int_slope = (A - t_crit * std_err_slope, A + t_crit * std_err_slope)
conf_int_intercept = (0 - t_crit * std_err_intercept, 0 + t_crit * std_err_intercept)  # Intercept is assumed to be 0 for sin fit

# === Plot ===
plt.figure(figsize=(8, 5))
# Removed the expected line from the plot
plt.plot(angles_deg, force_n, 'o-', label='Measured Force [N]')
# === Add Fitted Curve to Plot ===
theta_fine = np.linspace(0, np.pi / 2, 500)  # Fine grid for smooth curve
plt.plot(np.degrees(theta_fine), sin_fit(theta_fine, A), '--', label='Fitted Curve')
plt.xlabel('Angle θ (degrees)')
plt.ylabel('Force F (N)')
plt.title('Magnetic Force vs. Angle')
plt.grid(True)
plt.legend()
plt.tight_layout()

# === Annotate Plot with Metrics ===
textstr = (f"A (fit to sin(θ)) = {A:.5f} ± {A_uncertainty:.5f} N\n"
           f"B = {B:.5f} ± {B_uncertainty:.5f} T\n"
           f"RMSE = {rmse:.5f} N\n"
           f"SSE = {ss_res:.5f} N²")

props = dict(boxstyle='round', facecolor='wheat', alpha=0.5)
plt.gca().text(0.95, 0.95, textstr, transform=plt.gca().transAxes, fontsize=10,
               verticalalignment='top', horizontalalignment='right', bbox=props)

