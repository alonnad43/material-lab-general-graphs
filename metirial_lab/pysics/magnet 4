IA_empty_err = 0.01  # A

# Part B – With Metal Core
IA_core = np.array([0.0, 0.4, 0.8, 1.2, 1.6])
IB_core = np.array([0.0, 36.8, 67.4, 98.2, 128.5])
IB_core_err = 0.5
IA_core_err = 0.01

# Part C – Effect of Distance (IA = constant)
d = np.array([1, 2, 3, 4, 5])  # cm
IB_dist = np.array([22.7, 15.9, 12.2, 9.1, 7.1])
