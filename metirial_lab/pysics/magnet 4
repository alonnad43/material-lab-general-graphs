plt.savefig(os.path.join(output_dir, "Part_C_IB_vs_Distance.png"))
plt.close()

# === Plot C: Exponential Decay Fit ===
from scipy.optimize import curve_fit

def exp_fit(d, a, b):
    return a * np.exp(b * d)

popt, pcov = curve_fit(exp_fit, d, IB_dist)
a, b = popt
perr = np.sqrt(np.diag(pcov))  # Uncertainties in a and b
rmse_c = np.sqrt(np.mean((IB_dist - exp_fit(d, *popt)) ** 2))
sse_c = np.sum((IB_dist - exp_fit(d, *popt)) ** 2)

plt.figure(figsize=(8, 5))
plt.errorbar(d, IB_dist, yerr=IB_dist_err, fmt='o', capsize=4, color='purple', label='Measured IB at d')
plt.plot(d, exp_fit(d, *popt), '-', color='red', label=f'Fit: IB = {a:.2f}·exp({b:.2f}·d)')
plt.xlabel("Distance d [cm]")
plt.ylabel("IB [mA]")
plt.title("Induced Current IB vs. Distance Between Coils")
plt.grid(True)
plt.legend(loc='lower left')

textstr = (f"a = {a:.3f} ± {perr[0]:.3f} mA\n"
           f"b = {b:.3f} ± {perr[1]:.3f} 1/cm\n"
           f"R² = {1 - (sse_c / np.sum((IB_dist - np.mean(IB_dist)) ** 2)):.4f}\n"
           f"RMSE = {rmse_c:.3f} mA\n"
           f"SSE = {sse_c:.3f} mA²")
props = dict(boxstyle='round', facecolor='wheat', alpha=0.5)
plt.gca().text(0.95, 0.95, textstr, transform=plt.gca().transAxes,
               fontsize=10, verticalalignment='top', horizontalalignment='right', bbox=props)

plt.tight_layout()
plt.savefig(os.path.join(output_dir, "Part_C_IB_vs_Distance.png"))
plt.close()

