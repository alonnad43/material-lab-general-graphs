# === Output directory ===
output_dir = r"C:\Users\ramaa\OneDrive\Nadav\לימודים\בן גוריון\לימודים\הנסדת חורמים\סמסטר ו\מעבדת פיזיקה 2\מגנתויות\Nisui_2.3.1_Graphs"
