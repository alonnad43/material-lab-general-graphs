# === Plot C: Distance Effect ===
slope_c, intercept_c, *_ = linregress(d, IB_dist)
fit_line_c = slope_c * d + intercept_c
rmse_c = np.sqrt(np.mean((IB_dist - fit_line_c) ** 2))
sse_c = np.sum((IB_dist - fit_line_c) ** 2)

plt.figure(figsize=(8, 5))
plt.errorbar(d, IB_dist, yerr=IB_dist_err, fmt='o', capsize=4, color='purple', label='Induced Current vs Distance')
plt.plot(d, fit_line_c, '--', color='black', label=f'Fit: IB = {slope_c:.2f}·d + {intercept_c:.2f}')
plt.xlabel("Distance d [cm]")
plt.ylabel("IB [mA]")
plt.title("Part C: IB vs. Distance Between Coils")
plt.grid(True)
plt.legend(loc='lower left')

textstr = (f"A = {slope_c:.5f} mA/cm\n"
           f"B = {intercept_c:.5f} mA\n"
           f"RMSE = {rmse_c:.3f} mA\n"
           f"SSE = {sse_c:.3f} mA²")
