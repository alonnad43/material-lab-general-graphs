# Debugging: Print output paths to verify saving
print(f"Saving Part A graph to: {os.path.join(output_dir, 'Part_A_IB_vs_IA_Empty_Coil.png')}")
print(f"Saving Part B graph to: {os.path.join(output_dir, 'Part_B_IB_vs_IA_With_Core.png')}")
print(f"Saving Part C graph to: {os.path.join(output_dir, 'Part_C_IB_vs_Distance.png')}")

# === Helper function for linear fit plots ===
def plot_with_linear_fit(x, y, x_err, y_err, xlabel, ylabel, title, filename, color, label_desc):
    slope, intercept, r_value, p_value, std_err = linregress(x, y)
    fit_line = slope * x + intercept
    rmse = np.sqrt(np.mean((y - fit_line) ** 2))
    sse = np.sum((y - fit_line) ** 2)

    plt.figure(figsize=(8, 5))
    plt.errorbar(x, y, xerr=x_err, yerr=y_err, fmt='o', capsize=4, label=label_desc, color=color)
    plt.plot(x, fit_line, '-', label=f'Fit: IB = {slope:.2f}·IA + {intercept:.2f}', color='red')
    plt.xlabel(xlabel)
    plt.ylabel(ylabel)
    plt.title(title)
    plt.grid(True)
    plt.legend(loc='lower right')

    textstr = (f"Slope (a) = {slope:.3f} ± {std_err:.3f} mA/A\n"
               f"Intercept (b) = {intercept:.2f} ± {std_err:.2f} mA\n"
               f"R² = {r_value**2:.4f}\n"
               f"RMSE = {rmse:.3f} mA\n"
               f"SSE = {sse:.3f} mA²")
    props = dict(boxstyle='round', facecolor='wheat', alpha=0.5)
    plt.gca().text(0.05, 0.95, textstr, transform=plt.gca().transAxes,
                   fontsize=10, verticalalignment='top', bbox=props)

    plt.tight_layout()
    plt.savefig(os.path.join(output_dir, filename))
    plt.close()

# === Plot A: Empty Coil ===
